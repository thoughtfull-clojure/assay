;; assay configuration for this workspace. See README.md.
{;; Rules for each brick's and each function's metrics, merged over the
 ;; defaults. A metric listed here replaces all of its default rules; []
 ;; disables them.
 :brick-thresholds {}
 :function-thresholds {}

 ;; Levels for dependency checks: :error, :warning, or nil to turn off.
 :dependency-rules {}

 ;; Rules for how much a brick's metrics may grow, applied with --base.
 :change-thresholds {:mean-function-complexity [{:rule :max-increase :value 1
                                                 :level :warning}]
                     :forms [{:rule :max-increase-percent :value 50
                              :level :warning}]}}
