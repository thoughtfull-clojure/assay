;; Babashka runs assay with ~0.1 s startup, fast enough for a Git hook.
;; Keep brick source babashka-compatible; `bb test` checks it.
{:paths ["components/workspace/src"
         "components/parse/src"
         "components/metrics/src"
         "components/thresholds/src"
         "components/baseline/src"
         "components/dependencies/src"
         "components/git/src"
         "components/html-report/src"
         "components/github-report/src"
         "components/text-report/src"
         "bases/cli/src"]
 :tasks
 {assay
  {:doc "Run assay: bb assay [options]"
   :requires ([systems.thoughtfull.assay.cli.main :as main])
   ;; This repo keeps its config in .config/; assay's default is assay.edn.
   :task (apply main/-main "--config" ".config/assay.edn"
           *command-line-args*)}

  sample-report
  {:doc "Regenerate docs/sample-report.html from this workspace"
   :task (shell (str "bb assay --format html --warnings --no-fail"
                  " --output docs/sample-report.html"))}

  test
  {:doc "Run every brick's tests under babashka"
   :extra-paths ["components/workspace/test"
                 "components/parse/test"
                 "components/metrics/test"
                 "components/thresholds/test"
                 "components/baseline/test"
                 "components/dependencies/test"
                 "components/git/test"
                 "components/html-report/test"
                 "components/github-report/test"
                 "components/text-report/test"
                 "bases/cli/test"]
   :requires ([babashka.fs :as fs]
              [clojure.string :as str]
              [clojure.test :as t])
   :task (let [nss (for [test-dir (concat (fs/glob "." "components/*/test")
                                    (fs/glob "." "bases/*/test"))
                         f (fs/glob test-dir "**_test.clj")]
                     (-> (str (fs/relativize test-dir f))
                       (str/replace ".clj" "")
                       (str/replace "/" ".")
                       (str/replace "_" "-")
                       symbol))]
           (apply require nss)
           (let [{:keys [fail error]} (apply t/run-tests nss)]
             (System/exit (if (pos? (+ fail error)) 1 0))))}}}
